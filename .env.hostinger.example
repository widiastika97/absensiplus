# Contoh .env untuk Hostinger (hPanel) — copy ke .env lalu isi nilai sebenarnya.
# 1. Buat database MySQL di hPanel → Databases. Gunakan host, nama db, user & password yang ditampilkan hPanel.
# 2. Set "PHP Version" di hPanel minimal 8.4.
# 3. Jalankan migrasi: upload project, lalu dari terminal hPanel:
#    php artisan key:generate && php artisan migrate --force

APP_NAME="Absenplus+"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-anda.com

# Kosongkan jika APP_URL sudah benar; asset() akan memakai APP_URL sebagai basis.
ASSET_URL=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=error

# MySQL Hostinger (nilai contoh — samakan dengan yang ada di hPanel)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u538000323_absensi_smk
DB_USERNAME=u538000323_root
DB_PASSWORD=Mes@ri2027

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=file

FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@domain-anda.com
MAIL_PASSWORD=PASSWORD_EMAIL
MAIL_FROM_ADDRESS="no-reply@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
